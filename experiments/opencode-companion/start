#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")"
mkdir -p .runtime
export XDG_CONFIG_HOME="$PWD/.runtime/config"
export XDG_DATA_HOME="$PWD/.runtime/data"
export XDG_CACHE_HOME="$PWD/.runtime/cache"
export XDG_STATE_HOME="$PWD/.runtime/state"
export OPENCODE_DB="$PWD/.runtime/opencode.db"
if [[ $# == 0 ]]; then
  set -- --prompt "Start or resume the ROSA workshop companion. Load rosa-companion and guide me one step at a time."
fi
if [[ "${1:-}" == serve ]]; then
  exec "$HOME/.local/share/rosa-companion/opencode2" "$@"
fi
exec "$HOME/.local/share/rosa-companion/opencode2" --standalone "$@"
